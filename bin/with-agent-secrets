#!/usr/bin/env bash
set -euo pipefail
IFS=$'\n\t'

readonly SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly AGENT_SECRET="$SCRIPT_DIR/agent-secret"

usage() {
  echo "Usage: with-agent-secrets NAME [NAME ...] -- command [args ...]" >&2
}

names=()
while [[ $# -gt 0 ]] && [[ "$1" != "--" ]]; do
  if [[ ! "$1" =~ ^[A-Z][A-Z0-9_]*$ ]]; then
    echo "Invalid secret name: $1" >&2
    exit 2
  fi
  names+=("$1")
  shift
done

if [[ ${#names[@]} -eq 0 ]] || [[ "${1:-}" != "--" ]]; then
  usage
  exit 2
fi
shift

if [[ $# -eq 0 ]]; then
  usage
  exit 2
fi

for name in "${names[@]}"; do
  value="$("$AGENT_SECRET" get "$name")"
  export "$name=$value"
  unset value
done

exec "$@"
