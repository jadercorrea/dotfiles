#!/usr/bin/env bash
set -euo pipefail
IFS=$'\n\t'

readonly DOTFILES_ROOT="${DOTFILES:-$HOME/.dotfiles}"
readonly MANIFEST="$DOTFILES_ROOT/agents/secrets.manifest"
readonly HELPER_SOURCE="$DOTFILES_ROOT/agents/bin/keychain-secret.swift"
readonly HELPER_DIR="$DOTFILES_ROOT/.agent-cache"
readonly HELPER="$HELPER_DIR/agent-keychain"
readonly KEYCHAIN_SERVICE="dev.jadercorrea.agent-secrets.v2"

usage() {
  cat <<'EOF'
Usage:
  agent-secret get NAME
  agent-secret has NAME
  agent-secret list
  agent-secret set NAME
EOF
}

validate_name() {
  local name="${1:-}"
  if [[ ! "$name" =~ ^[A-Z][A-Z0-9_]*$ ]]; then
    echo "Invalid secret name: $name" >&2
    exit 2
  fi
}

require_macos() {
  if [[ "$(uname -s)" != "Darwin" ]] || [[ ! -x /usr/bin/security ]]; then
    echo "agent-secret requires macOS Keychain." >&2
    exit 1
  fi
}

require_compiler() {
  if [[ ! -x /usr/bin/swiftc ]]; then
    echo "agent-secret set requires the macOS Swift compiler." >&2
    exit 1
  fi
}

ensure_helper() {
  if [[ ! -x "$HELPER" ]] || [[ "$HELPER_SOURCE" -nt "$HELPER" ]]; then
    mkdir -p "$HELPER_DIR"
    /usr/bin/swiftc "$HELPER_SOURCE" -framework Security -o "$HELPER"
  fi
}

command="${1:-}"
case "$command" in
  get)
    require_macos
    validate_name "${2:-}"
    exec /usr/bin/security find-generic-password \
      -s "$KEYCHAIN_SERVICE" \
      -a "$2" \
      -w
    ;;
  has)
    require_macos
    validate_name "${2:-}"
    /usr/bin/security find-generic-password \
      -s "$KEYCHAIN_SERVICE" \
      -a "$2" \
      >/dev/null 2>&1
    ;;
  list)
    if [[ ! -f "$MANIFEST" ]]; then
      echo "Secret manifest not found: $MANIFEST" >&2
      exit 1
    fi
    sed -e '/^[[:space:]]*#/d' -e '/^[[:space:]]*$/d' "$MANIFEST"
    ;;
  set)
    require_macos
    require_compiler
    validate_name "${2:-}"
    if [[ ! -f "$HELPER_SOURCE" ]]; then
      echo "Keychain helper source not found: $HELPER_SOURCE" >&2
      exit 1
    fi
    ensure_helper

    read -r -s -p "Secret value for $2: " secret
    printf '\n' >&2
    read -r -s -p "Confirm secret value: " confirmation
    printf '\n' >&2

    if [[ "$secret" != "$confirmation" ]]; then
      unset secret confirmation
      echo "Secret values do not match." >&2
      exit 1
    fi

    printf '%s' "$secret" | "$HELPER" set "$2"
    unset secret confirmation
    echo "Stored $2 in macOS Keychain."
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
