#!/usr/bin/env ruby
# frozen_string_literal: true

require "open3"
require "digest"

SAFE_MARKERS = /
  redacted |
  placeholder |
  changeme |
  dummy |
  example |
  your[_-] |
  x{4,} |
  sk-1234567890abcdef |
  abc123 |
  mysecret |
  secret-value |
  development-secret |
  test-secret |
  (?:process\.)?env\. |
  os\.getenv |
  input\. |
  vars?\. |
  config\. |
  agent-secret |
  process\.env
/ix

PREFIX_PATTERNS = [
  /sk-(?:live|prod|test|or-v1)-[A-Za-z0-9_-]{16,}/,
  /gsk_[A-Za-z0-9]{16,}/,
  /hf_[A-Za-z0-9]{20,}/,
  /xox[baprs]-[A-Za-z0-9-]{16,}/,
  /gh[pousr]_[A-Za-z0-9]{20,}/,
  /AKIA[0-9A-Z]{16}/,
  /AIza[0-9A-Za-z_-]{30,}/,
  /-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----/
].freeze

# Exact path-and-line fingerprints for reviewed examples in imported skills.
# Any edit changes the fingerprint and makes the scanner evaluate the line again.
REVIEWED_EXAMPLE_FINGERPRINTS = %w[
  ff33ca9b9f2796706abd20b713ecad8321efa965ce0d62497ba0aa56db89a930
  7828be061e2fba82e1725a1dc2954b1fb698cbc42dd81468cc586500289d5d9d
  0f9326873b1a2ff7eeabf99b3e80f546dd1ee3a1866b5af4aee1a0baaff8ed70
  a19fa0fb87b918d77bf8e2d107a42b90323352829707ffbbf452e799de5957f9
  b9ef51f8c0fcdab703cc7b18eb98ad47c0bb33eab1e9dedb64425463875090e6
  6ea058ceb19df1b19ab1a6752cfa2e702b0e3757cedbd94ca929df50efe5c443
  91ac06294bc28eba5e5d37e8b8dd502004532e2b1d667e1915be8afcabe775c5
  a8950bab05af22c314909d4a8047cfc0f1b5807042fd05cc99445b2174aa4fb5
  d8aae3b91a86817822585673389f23a6cd1396b47d714839d3c3e3757630cbd0
  97a198fe450358fb11221e9ddb22b4eb33b2bdfebfbea445edc569942b6655c3
  03787b6ec9f0423d72fdd4a564f89d5de333d4e5a9a917983f57b50ea9823bee
  0eadb80bf36cbaaad8e0b374f526a18d48d57753daf40209f76b3d1c42b5a589
  d7e21c9984182bd3b4afe51b83368c3bc315fe2ed74b358a743bd55ce9534e48
  cffac741abf445ff55536f5ef55dcc0b9835c55fa8157774d5c989ad892aa772
  11ae4ff957b265f2f5fc376a92bcdd8504b7886646103216c97d96df8c1a568b
  a3559f3f186099e9f4f96e2bd84c5001a349399d409c23542ee3fdb5b4f5abfa
].freeze

URI_CREDENTIAL = %r{
  \b[a-z][a-z0-9+.-]*://
  [^/\s:@]+:
  ([^@\s/]+)@
}ix

SENSITIVE_ASSIGNMENT = /
  (?:
    api[_-]?key |
    access[_-]?token |
    auth[_-]?token |
    bot[_-]?token |
    client[_-]?secret |
    private[_-]?key |
    password |
    secret[_-]?key |
    webhook[_-]?secret |
    jwt[_-]?secret
  )
  \s*[:=]\s*
  ["']?
  ([^"'$<{\s][^"'\s]{7,})
/ix

def suspicious?(path, line)
  fingerprint = Digest::SHA256.hexdigest("#{path}\0#{line.chomp}")
  return false if REVIEWED_EXAMPLE_FINGERPRINTS.include?(fingerprint)
  return false if line.match?(SAFE_MARKERS)
  return true if PREFIX_PATTERNS.any? { |pattern| line.match?(pattern) }
  return true if line.match?(URI_CREDENTIAL)

  match = line.match(SENSITIVE_ASSIGNMENT)
  return false unless match

  value = match[1]
  !value.match?(
    /\A(?:true|false|null|none|string|await|Promise<string>)\b/i
  )
end

def staged_lines
  output, error, status = Open3.capture3(
    "git", "diff", "--cached", "--no-ext-diff", "--unified=0", "--"
  )
  abort error unless status.success?

  file = nil
  line_number = 0

  output.each_line.filter_map do |line|
    if line.start_with?("+++ b/")
      file = line.delete_prefix("+++ b/").strip
      next
    end

    if (header = line.match(/^@@ .*\+(\d+)/))
      line_number = header[1].to_i
      next
    end

    next if line.start_with?("---", "+++")

    if line.start_with?("+")
      result = [file, line_number, line.delete_prefix("+")]
      line_number += 1
      result
    elsif line.start_with?(" ")
      line_number += 1
      nil
    end
  end
end

def tracked_lines
  output, error, status = Open3.capture3("git", "ls-files", "-z")
  abort error unless status.success?

  output.split("\0").flat_map do |path|
    next [] unless File.file?(path)
    next [] if File.size(path) > 2 * 1024 * 1024

    content = File.binread(path)
    next [] if content.include?("\0")

    content.encode(
      "UTF-8",
      invalid: :replace,
      undef: :replace,
      replace: ""
    ).each_line.with_index(1).map { |line, number| [path, number, line] }
  end
end

mode = ARGV.first || "--all"
lines =
  case mode
  when "--staged" then staged_lines
  when "--all" then tracked_lines
  else
    abort "Usage: scan-secrets [--staged|--all]"
  end

findings = lines.select { |path, _number, line| suspicious?(path, line) }

if findings.empty?
  puts "Secret scan passed (#{mode.delete_prefix('--')})."
  exit 0
end

warn "Potential secrets detected:"
findings.each do |path, number, _line|
  warn "- #{path}:#{number}"
end
exit 1
